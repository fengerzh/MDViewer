{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDViewer",
  "version": "0.1.0",
  "identifier": "com.yunkecn.mdviewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MDViewer",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.extra.plist"
    }
  }
}
